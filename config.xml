<?xml version="1.0" encoding="utf-8"?>
<widget id="com.hotcodepush.demo.cordova" version="1.0.0"
    xmlns="http://www.w3.org/ns/widgets"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <name>HotCodePush Demo</name>
    <description>The HotCodePush Cordova code push demo app</description>
    <author href="https://hotcodepush.com">Genz IT Solutions GmbH</author>
    <content src="index.html" />
    <platform name="android">
        <resource-file src="res/android/xml/network_security_config.xml" target="app/src/main/res/xml/network_security_config.xml" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:networkSecurityConfig="@xml/network_security_config" />
        </edit-config>
    </platform>
    <platform name="ios">
        <!-- The device test runs against a local stack on the host over plain HTTP. -->
        <edit-config file="*-Info.plist" mode="merge" target="NSAppTransportSecurity">
            <dict>
                <key>NSAllowsLocalNetworking</key>
                <true />
            </dict>
        </edit-config>
    </platform>
</widget>
